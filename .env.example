# nano-cycle deployment environment — copy to .env and fill in.
# .env is gitignored; scripts/deploy.sh consumes it. NEVER commit the real one.
#
# searxng and obscura do NOT need entries here: deploy.sh installs searxng
# (standalone venv, docker fallback; 127.0.0.1:8888) and obscura from a pinned
# GitHub release automatically, and the server probes both at boot.

# --- server binding ----------------------------------------------------------
# Port the host server listens on. Rule: NANO_PORT, else PORT, else 4177.
NANO_PORT=4177
# Bind address. Default 127.0.0.1 (this machine only) - the safe choice: put
# Tailscale serve / Caddy (TLS) in front for remote access. 0.0.0.0 is allowed
# (the token is always required) but the server warns unless NANO_PUBLIC_URL
# is https, because the token and cookie would cross the network in cleartext.
#NANO_HOST=0.0.0.0

# --- access control -----------------------------------------------------------
# Every /api route, the WebSocket and the GUI require a token. Default: a random
# one is generated at first boot, printed once, and kept 0600 in ./.nano-token.
# Pin your own instead (>= 24 chars):
#NANO_TOKEN=
#NANO_TOKEN_FILE=/var/lib/nano-cycle/token
# Public https URL of the GUI behind your proxy (login link + TLS warning only).
#NANO_PUBLIC_URL=https://nano.your-tailnet.ts.net
# Extra browser Origins allowed to write / open the WebSocket - needed only when
# the proxy rewrites the Host header (comma-separated origins).
#NANO_ALLOWED_ORIGINS=https://nano.example.com
# Optional DNS-rebinding guard: only answer these Host headers (comma-separated).
#NANO_ALLOWED_HOSTS=nano.example.com
# Behind a proxy, rate-limit failed logins per real client (X-Forwarded-For).
#NANO_TRUST_PROXY=1
# Request body cap in bytes (default 5242880).
#NANO_MAX_BODY_BYTES=5242880

# --- agent credentials (written to ~/.pi/agent/auth.json by deploy.sh) --------
# The EXACT content of a pi auth.json — a provider→credentials map, e.g.
#   {"zai-coding-cn": {"type": "api", "key": "..."}, "opencode": {...}}
# Copy it from a machine where pi is logged in: cat ~/.pi/agent/auth.json
# SINGLE-QUOTE the value in this file. deploy.sh refuses to overwrite an
# existing auth.json unless --force-auth is passed.
PI_AUTH_JSON=

# Optional: pi model registry overrides (content of ~/.pi/agent/models-store.json).
#PI_MODELS_STORE_JSON=

# --- overrides (everything above this line has automatic defaults) -------------
# Point web_search at a DIFFERENT searxng instance (default: the local docker
# container deploy.sh manages at http://127.0.0.1:8888 — base URL, no /search).
#NANO_SEARXNG_URL=http://search.internal:8888

# Pinned versions deploy.sh installs (bump deliberately):
#NANO_OBSCURA_VERSION=v0.2.4
#NANO_SEARXNG_REF=6671d89bede8c9fc108b17bb98916170f5657650
#NANO_SEARXNG_IMAGE=searxng/searxng:2026.10.7-6671d89be
